+private final class ActivationNativeCostProfile: @unchecked Sendable {
+    private let lock = NSLock()
+    private var totals: [String: (calls: Int, seconds: Double)] = [:]
+    func measure<Value>(_ name: String, _ body: () throws -> Value) rethrows -> Value {
+        let began = ContinuousClock.now
+        defer {
+            let duration = began.duration(to: .now).components
+            lock.withLock {
+                let old = totals[name] ?? (0, 0)
+                totals[name] = (old.calls + 1, old.seconds + Double(duration.seconds) + Double(duration.attoseconds) / 1e18)
+            }
+        }
+        return try body()
+    }
+    func report() {
+        let snapshot = lock.withLock { totals }
+        for key in snapshot.keys.sorted() {
+            let value = snapshot[key]!
+            FileHandle.standardError.write(Data("NATIVE \(key) calls=\(value.calls) seconds=\(value.seconds)\n".utf8))
+        }
+    }
+    func wrapping(_ base: GraphCoordinatorAdapter) -> GraphCoordinatorAdapter {
+        guard let sync = base.sync, let cloud = sync.cloud else { return base }
+        let measuredCloud = GraphCloudStoreAdapter(prepare: { c, id, b, n, limits, selected in
+            try self.measure("prepare") { try cloud.prepare(c, id, b, n, limits, selected) }
+        }, finishPrepared: { c, id, b, batch, limits in
+            try self.measure("finish") { try cloud.finishPrepared(c, id, b, batch, limits) }
+        }, currentAttempt: { c, id, b, limits in
+            try self.measure("current") { try cloud.currentAttempt(c, id, b, limits) }
+        }, sent: { c, id, b, receipts, assets, remoteAssets, files, limits in
+            try self.measure("sent") { try cloud.sent(c, id, b, receipts, assets, remoteAssets, files, limits) }
+        }, apply: { c, id, b, effects, limits in
+            try self.measure("apply") { try cloud.apply(c, id, b, effects, limits) }
+        }, trim: { c, id, b, cleanup in
+            try self.measure("trim") { try cloud.trim(c, id, b, cleanup) }
+        })
+        var measuredSync = GraphSyncAdapter(cloud: measuredCloud, collect: { c, id, limits in
+            try self.measure("collect") { try sync.collect(c, id, limits) }
+        }, prepare: sync.prepare, acknowledge: sync.acknowledge, importPatches: sync.importPatches)
+        measuredSync.policy = sync.policy
+        var result = GraphCoordinatorAdapter(graph: base.graph, sync: measuredSync, v1Conversion: base.v1Conversion,
+            migrationSource: base.migrationSource, initializePolicy: base.initializePolicy, publication: base.publication,
+            workspace: base.workspace, prepareWorkspace: base.prepareWorkspace, validateBackup: base.validateBackup,
+            account: base.account, initialize: base.initialize)
+        result.activation = base.activation; result.nativeV1Migration = base.nativeV1Migration
+        return result
+    }
+}
